<?xml version="1.0" encoding="utf-8" ?>
<!--
    SAMPLE_DESIGN_USAGE.xaml

    This sample demonstrates proper application of DESIGN.md tokens in a hypothetical
    "Recording Summary" page. It shows:
    - Correct color token usage (text-*, surface-*, semantic-*)
    - Spacing scale application (8px grid)
    - Typography scale (12px-32px tiers)
    - Component patterns (buttons, forms, focus indicators)
    - Accessibility requirements (AutomationProperties.Name)

    Reference: .claude/rules/design-colors.rules.md, design-spacing.rules.md,
               design-typography.rules.md, design-components.rules.md
-->

<Page
    x:Class="IntVue.Views.RecordingSummaryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:IntVue.ViewModels"
    Background="{ThemeResource SolidBackgroundFillColorBaseBrush}">

    <!-- ============================================================================
         SECTION 1: Page Structure & Main Surface
         Token: surface-primary (SolidBackgroundFillColorBaseBrush)
         Spacing: spacing-lg (16px vertical sections)
         ============================================================================ -->

    <Page.DataContext>
        <vm:RecordingSummaryViewModel />
    </Page.DataContext>

    <ScrollViewer>
        <StackPanel Spacing="16" Padding="16">

            <!-- ====================================================================
                 HEADER: Title with semantic color
                 Typography: type-title (20px, bold)
                 Color: text-primary (TextFillColorPrimaryBrush)
                 ==================================================================== -->

            <TextBlock
                Text="Recording Summary"
                FontSize="20"
                FontWeight="Bold"
                Foreground="{ThemeResource TextFillColorPrimaryBrush}" />

            <!-- ====================================================================
                 RECORDING INDICATOR: Always visible when active
                 Component Pattern: recording-indicator
                 Color: semantic-error (SystemFillColorCriticalBrush)
                 Spacing: spacing-sm (8px)
                 ==================================================================== -->

            <Grid
                Background="{ThemeResource SystemFillColorCriticalBrush}"
                CornerRadius="4"
                Padding="8,4"
                Visibility="{x:Bind ViewModel.IsRecording, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">

                <AutomationProperties.Name>Recording in progress</AutomationProperties.Name>

                <StackPanel Orientation="Horizontal" Spacing="4">
                    <Ellipse
                        Width="8"
                        Height="8"
                        Fill="{ThemeResource TextFillColorPrimaryBrush}" />
                    <TextBlock
                        Text="Recording"
                        Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                        FontWeight="Bold"
                        FontSize="14"
                        VerticalAlignment="Center" />
                </StackPanel>
            </Grid>

            <!-- ====================================================================
                 INFO SECTION: Secondary surface with content
                 Token: surface-secondary (SolidBackgroundFillColorSecondaryBrush)
                 Spacing: spacing-md (12px padding)
                 Corner radius: radius-card (8px)
                 ==================================================================== -->

            <StackPanel
                Background="{ThemeResource SolidBackgroundFillColorSecondaryBrush}"
                CornerRadius="8"
                Padding="12"
                Spacing="8">

                <!-- Section Header (type-subtitle) -->
                <TextBlock
                    Text="Session Information"
                    FontSize="16"
                    FontWeight="SemiBold"
                    Foreground="{ThemeResource TextFillColorPrimaryBrush}" />

                <!-- Info items with secondary text color -->
                <StackPanel Spacing="4">
                    <TextBlock
                        Text="Duration"
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock
                        Text="{x:Bind ViewModel.RecordingDuration, Mode=OneWay}"
                        FontSize="14"
                        Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                </StackPanel>

                <StackPanel Spacing="4">
                    <TextBlock
                        Text="Date & Time"
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock
                        Text="{x:Bind ViewModel.RecordingDate, Mode=OneWay}"
                        FontSize="14"
                        Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                </StackPanel>
            </StackPanel>

            <!-- ====================================================================
                 CONTROLS SECTION: Action buttons
                 Spacing: spacing-sm (8px between buttons, spacing-lg for section break)
                 Button Patterns: secondary (default), primary (accent style)
                 ==================================================================== -->

            <StackPanel Spacing="16">
                <!-- Section Label (type-subtitle) -->
                <TextBlock
                    Text="Actions"
                    FontSize="16"
                    FontWeight="SemiBold"
                    Foreground="{ThemeResource TextFillColorPrimaryBrush}" />

                <!-- Button Group -->
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <!-- Secondary button (Preview) -->
                    <Button
                        x:Name="BtnPlayRecording"
                        Content="Play Recording"
                        IsEnabled="{x:Bind ViewModel.HasRecording, Mode=OneWay}"
                        AutomationProperties.Name="Play the recorded session"
                        Command="{x:Bind ViewModel.PlayCommand}" />

                    <!-- Primary/Accent button (Save) -->
                    <Button
                        x:Name="BtnSaveRecording"
                        Content="Save Recording"
                        Style="{ThemeResource AccentButtonStyle}"
                        IsEnabled="{x:Bind ViewModel.HasRecording, Mode=OneWay}"
                        AutomationProperties.Name="Save the recording to storage"
                        Command="{x:Bind ViewModel.SaveCommand}" />

                    <!-- Secondary button (Delete) -->
                    <Button
                        x:Name="BtnDeleteRecording"
                        Content="Delete"
                        IsEnabled="{x:Bind ViewModel.HasRecording, Mode=OneWay}"
                        AutomationProperties.Name="Delete this recording"
                        Command="{x:Bind ViewModel.DeleteCommand}" />
                </StackPanel>
            </StackPanel>

            <!-- ====================================================================
                 FORM SECTION: User settings (ComboBox example)
                 Spacing: spacing-md (12px) for form groups
                 Form Pattern: label + control layout
                 ==================================================================== -->

            <StackPanel Spacing="12">
                <!-- Section Label -->
                <TextBlock
                    Text="Save Options"
                    FontSize="16"
                    FontWeight="SemiBold"
                    Foreground="{ThemeResource TextFillColorPrimaryBrush}" />

                <!-- Form Field: Resolution -->
                <StackPanel Spacing="4">
                    <TextBlock
                        Text="Recording Resolution"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                    <ComboBox
                        ItemsSource="{x:Bind ViewModel.ResolutionOptions, Mode=OneWay}"
                        SelectedItem="{x:Bind ViewModel.SelectedResolution, Mode=TwoWay}"
                        MinWidth="200"
                        AutomationProperties.Name="Recording resolution selection" />
                </StackPanel>

                <!-- Form Field: Auto-save Checkbox -->
                <CheckBox
                    Content="Auto-save to default location"
                    IsChecked="{x:Bind ViewModel.AutoSave, Mode=TwoWay}"
                    AutomationProperties.Name="Auto-save checkbox" />
            </StackPanel>

            <!-- ====================================================================
                 COUNTDOWN SECTION: Feature-specific display (72px exception)
                 Component Pattern: countdown-display
                 Color: Dynamic via ViewModel.CountdownColor
                 Spacing: spacing-lg (16px above)
                 ==================================================================== -->

            <Grid
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Padding="0,16,0,0"
                Visibility="{x:Bind ViewModel.IsCountingDown, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">

                <TextBlock
                    x:Name="TxtCountdown"
                    Text="{x:Bind ViewModel.CountdownSeconds, Mode=OneWay}"
                    FontSize="72"
                    FontWeight="Bold"
                    Foreground="{x:Bind ViewModel.CountdownColor, Mode=OneWay}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="Countdown timer"
                    LineHeight="108" />
            </Grid>

            <!-- Cancel Countdown Button (visible only during countdown) -->
            <Grid HorizontalAlignment="Center">
                <Button
                    x:Name="BtnCancelCountdown"
                    Content="Cancel Countdown"
                    Command="{x:Bind ViewModel.CancelCountdownCommand}"
                    Visibility="{x:Bind ViewModel.IsCountingDown, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                    AutomationProperties.Name="Cancel countdown timer" />
            </Grid>

            <!-- ====================================================================
                 DIVIDER: Subtle separator using stroke-subtle
                 Token: stroke-subtle (DividerStrokeColorDefaultBrush)
                 Height: 1px
                 ==================================================================== -->

            <Rectangle
                Height="1"
                Fill="{ThemeResource DividerStrokeColorDefaultBrush}"
                Margin="0,8,0,8" />

            <!-- ====================================================================
                 FEEDBACK SECTION: Status messages with semantic colors
                 Success: semantic-success (SystemFillColorSuccessBrush)
                 Error: semantic-error (SystemFillColorCriticalBrush)
                 Info: semantic-info (SystemFillColorAttentionBrush)
                 ==================================================================== -->

            <StackPanel Spacing="8">
                <!-- Success message -->
                <StackPanel
                    Visibility="{x:Bind ViewModel.ShowSuccessMessage, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                    Spacing="4">
                    <TextBlock
                        Text="Success"
                        FontSize="12"
                        FontWeight="SemiBold"
                        Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
                    <TextBlock
                        Text="{x:Bind ViewModel.SuccessMessage, Mode=OneWay}"
                        FontSize="14"
                        Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                </StackPanel>

                <!-- Error message -->
                <StackPanel
                    Visibility="{x:Bind ViewModel.ShowErrorMessage, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                    Spacing="4">
                    <TextBlock
                        Text="Error"
                        FontSize="12"
                        FontWeight="SemiBold"
                        Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                    <TextBlock
                        Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                        FontSize="14"
                        Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                </StackPanel>

                <!-- Info message -->
                <StackPanel
                    Visibility="{x:Bind ViewModel.ShowInfoMessage, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                    Spacing="4">
                    <TextBlock
                        Text="Info"
                        FontSize="12"
                        FontWeight="SemiBold"
                        Foreground="{ThemeResource SystemFillColorAttentionBrush}" />
                    <TextBlock
                        Text="{x:Bind ViewModel.InfoMessage, Mode=OneWay}"
                        FontSize="14"
                        Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                </StackPanel>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>

</Page>

<!--
    DESIGN TOKENS USED IN THIS SAMPLE:

    COLOR TOKENS:
    ✓ text-primary           → TextFillColorPrimaryBrush
    ✓ text-secondary         → TextFillColorSecondaryBrush
    ✓ surface-primary        → SolidBackgroundFillColorBaseBrush
    ✓ surface-secondary      → SolidBackgroundFillColorSecondaryBrush
    ✓ stroke-subtle          → DividerStrokeColorDefaultBrush
    ✓ semantic-success       → SystemFillColorSuccessBrush
    ✓ semantic-error         → SystemFillColorCriticalBrush
    ✓ semantic-info          → SystemFillColorAttentionBrush

    SPACING TOKENS:
    ✓ spacing-sm (8px)       → StackPanel Spacing="8", Button Margin spacing
    ✓ spacing-md (12px)      → Form field spacing, StackPanel Padding
    ✓ spacing-lg (16px)      → Section breaks, Page content Padding

    TYPOGRAPHY TOKENS:
    ✓ type-caption (12px)    → Status labels (FontSize="12")
    ✓ type-body (14px)       → Body text, info (FontSize="14")
    ✓ type-subtitle (16px)   → Section headers (FontSize="16")
    ✓ type-display (72px)    → Countdown (FontSize="72")

    WEIGHTS:
    ✓ Regular (400)          → Body text (implicit/default)
    ✓ SemiBold (600)         → Section headers
    ✓ Bold (700)             → Page title, emphasis

    BORDER RADIUS:
    ✓ radius-card (8px)      → Recording info panel, CornerRadius="8"
    ✓ radius-sm (4px)        → Recording indicator, CornerRadius="4"

    COMPONENT PATTERNS:
    ✓ Button states          → Secondary, Primary (AccentButtonStyle), Disabled
    ✓ Recording indicator    → Always visible, red background, white text
    ✓ Countdown display      → 72px, dynamic color, centered
    ✓ Form controls          → ComboBox, CheckBox with labels
    ✓ Accessibility          → AutomationProperties.Name on all interactive elements
    ✓ Keyboard navigation    → Tab order (implicit), Enter/Space on buttons

    WHAT NOT TO FIND:
    ✗ NO hard-coded colors (no #000000, #0078D4, etc.)
    ✗ NO arbitrary spacing (no Margin="10", Padding="15", etc.)
    ✗ NO custom font sizes outside the scale
    ✗ NO {Binding} (all use x:Bind with Mode=OneWay/TwoWay)
    ✗ NO missing automation properties on interactive controls
-->
