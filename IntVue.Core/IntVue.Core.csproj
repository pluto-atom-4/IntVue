<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <RootNamespace>IntVue</RootNamespace>
        <ImplicitUsings>enable</ImplicitUsings>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <!-- Code analysis & style enforcement settings -->
    <PropertyGroup>
        <!-- Enable built-in .NET analyzers -->
        <EnableNETAnalyzers>true</EnableNETAnalyzers>
        <!-- Use the recommended analysis level -->
        <AnalysisLevel>latest-recommended</AnalysisLevel>
        <!-- Apply code style in build to surface style issues during CI/builds -->
        <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
        <!-- Do not treat warnings as errors by default -->
        <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    </PropertyGroup>

    <!-- Isolated Rule Configurations -->
    <ItemGroup Label="CodeAnalysisConfigurations">
        <AdditionalFiles Include="stylecop.json" Visible="false" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="11.0.0-preview.4.26230.115" />
        <PackageReference Include="CommunityToolkit.Mvvm" Version="8.*" />
        <!-- Code analysis packages: enable Roslyn analyzers and StyleCop -->
        <PackageReference Include="Microsoft.CodeAnalysis.NetAnalyzers" Version="*" />
        <PackageReference Include="StyleCop.Analyzers" Version="*">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
        </PackageReference>
    </ItemGroup>

    <ItemGroup>
        <Folder Include="Services\" />
        <Folder Include="Models\" />
        <Folder Include="Converters\" />
        <Folder Include="ViewModels\" />
    </ItemGroup>
</Project>
