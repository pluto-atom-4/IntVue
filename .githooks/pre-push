#!/bin/sh
# Cross-platform pre-push shim that calls scripts/pre-push.ps1
if command -v pwsh >/dev/null 2>&1; then
  exec pwsh -NoProfile -ExecutionPolicy Bypass -File "$(dirname "$0")/../scripts/pre-push.ps1" "$@"
elif command -v powershell >/dev/null 2>&1; then
  exec powershell -NoProfile -ExecutionPolicy Bypass -File "$(dirname "$0")/../scripts/pre-push.ps1" "$@"
else
  echo "PowerShell is required to run repository hooks. Install pwsh or powershell." >&2
  exit 1
fi
