<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
        <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
        <RootNamespace>IntVue</RootNamespace>
        <ApplicationManifest>app.manifest</ApplicationManifest>
        <Platforms>x86;x64;ARM64</Platforms>
        <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-$([System.Runtime.InteropServices.RuntimeInformation]::ProcessArchitecture.ToString().ToLowerInvariant())</RuntimeIdentifier>
        <PublishProfile Condition="Exists('Properties\PublishProfiles\win-$(Platform).pubxml')">win-$(Platform).pubxml</PublishProfile>
        <UseWinUI>true</UseWinUI>
        <AssemblyVersion>1.0.0.0</AssemblyVersion>
        <FileVersion>1.0.0.0</FileVersion>
        <InformationalVersion>1.0.0</InformationalVersion>
        <WinUISDKReferences>false</WinUISDKReferences>
        <EnableMsixTooling>true</EnableMsixTooling>
        <ImplicitUsings>enable</ImplicitUsings>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <!-- Fixes CsWinRT1030 warning for generic WinRT projection objects -->
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <!-- Forces the WinUI 3 build to output a standard unpackaged .exe -->
        <WindowsPackageType>None</WindowsPackageType>
        <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
        <!-- Allow mixed WinUI and Windows SDK projections (required for Windows.Media APIs with WinUI 3) -->
        <EnableUnsafeMixedMicrosoftWindowsUIXamlProjections>true</EnableUnsafeMixedMicrosoftWindowsUIXamlProjections>
	<!-- Prevents dotnet format from double-evaluating WinUI auto-generated files -->
        <!-- Prevents dotnet from evaluating WinUI auto-generated files -->
        <DefaultItemExcludes>$(DefaultItemExcludes);obj\**;bin\**</DefaultItemExcludes>
        <DefaultItemExcludesInProjectFolder>$(DefaultItemExcludesInProjectFolder);obj\**;bin\**</DefaultItemExcludesInProjectFolder>
    </PropertyGroup>

    <!-- Code analysis & style enforcement settings (added per project guidelines) -->
    <PropertyGroup>
        <!-- Enable built-in .NET analyzers -->
        <EnableNETAnalyzers>true</EnableNETAnalyzers>
        <!-- Use the recommended analysis level -->
        <AnalysisLevel>latest-recommended</AnalysisLevel>
        <!-- Apply code style in build to surface style issues during CI/builds -->
        <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
        <!-- Do not treat warnings as errors by default; team can opt-in via CI -->
        <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
        <Nullable>enable</Nullable>
        <!-- Suppress CA1016 (assembly version) - already set in PropertyGroup above -->
        <!-- Suppress CA1416 (platform compatibility) - this is a Windows-only app -->
        <NoWarn>$(NoWarn);CA1016;CA1416</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <Content Include="Assets\SplashScreen.scale-200.png"/>
        <Content Include="Assets\LockScreenLogo.scale-200.png"/>
        <Content Include="Assets\Square150x150Logo.scale-200.png"/>
        <Content Include="Assets\Square44x44Logo.scale-200.png"/>
        <Content Include="Assets\Square44x44Logo.targetsize-24_altform-unplated.png"/>
        <Content Include="Assets\Square44x44Logo.targetsize-48_altform-lightunplated.png"/>
        <Content Include="Assets\StoreLogo.png"/>
        <Content Include="Assets\AppIcon.ico"/>
        <Content Include="Assets\Wide310x150Logo.scale-200.png"/>
    </ItemGroup>

    <!-- Isolated Rule Configurations (Ensures Rider pushes this to the compiler) -->
    <ItemGroup Label="CodeAnalysisConfigurations">
        <AdditionalFiles Include="stylecop.json" Visible="false" />
    </ItemGroup>

    <ItemGroup>
        <Manifest Include="$(ApplicationManifest)"/>
    </ItemGroup>

    <!--
      Defining the "Msix" ProjectCapability here allows the Single-project MSIX Packaging
      Tools extension to be activated for this project even if the Windows App SDK Nuget
      package has not yet been restored.
    -->
    <ItemGroup Condition="'$(DisableMsixProjectCapabilityAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
        <ProjectCapability Include="Msix"/>
    </ItemGroup>

    <!--
      Microsoft.Windows.SDK.BuildTools.WinApp adds first-class support for
      `dotnet run` on packaged WinUI apps: it hooks the .NET CLI Run target to
      register a debug identity via the winapp CLI and launch the app with
      package identity (AUMID).
      Set <EnableWinAppRunSupport>false</EnableWinAppRunSupport> in a
      <PropertyGroup> above to opt out.
    -->
    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="11.0.0-preview.4.26230.115" />
        <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.7705"/>
        <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260317003"/>
        <PackageReference Include="Microsoft.Windows.SDK.BuildTools.WinApp" Version="0.3.1"/>
        <PackageReference Include="Microsoft.Graphics.Win2D" Version="1.3.1"/>
	    <PackageReference Include="CommunityToolkit.WinUI.Extensions" Version="8.2.251219" />
	    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.*" />
        <!-- Code analysis packages: enable Roslyn analyzers and StyleCop -->
        <PackageReference Include="Microsoft.CodeAnalysis.NetAnalyzers" Version="*" />
        <PackageReference Include="StyleCop.Analyzers" Version="*">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
        </PackageReference>
    </ItemGroup>
    <ItemGroup>
      <Folder Include="Services\" />
    </ItemGroup>

    <!-- Exclude the Tests folder from the main project compile items so the test
         source files (which live under Tests\) are built only by the test
         project and do not cause compilation errors in the app project. -->
    <ItemGroup>
      <Compile Remove="Tests\**\*.cs" />
    </ItemGroup>
    <ItemGroup>
      <None Remove="gh-issue-content.md" />
      <None Remove="gh-issue-draft-rev1.md" />
      <None Remove="gh-issue-draft.md" />
      <None Remove="issue-content.json" />
    </ItemGroup>
    <!--
      Defining the "HasPackageAndPublishMenuAddedByProject" property here allows the Solution
      Explorer "Package and Publish" context menu entry to be enabled for this project even if
      the Windows App SDK Nuget package has not yet been restored.
    -->
    <PropertyGroup Condition="'$(DisableHasPackageAndPublishMenuAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
        <HasPackageAndPublishMenu>true</HasPackageAndPublishMenu>
    </PropertyGroup>

    <!-- Publish Properties -->
    <PropertyGroup>
        <PublishReadyToRun Condition="'$(Configuration)' == 'Debug'">False</PublishReadyToRun>
        <PublishReadyToRun Condition="'$(Configuration)' != 'Debug'">True</PublishReadyToRun>
        <PublishTrimmed Condition="'$(Configuration)' == 'Debug'">False</PublishTrimmed>
        <PublishTrimmed Condition="'$(Configuration)' != 'Debug'">True</PublishTrimmed>
    </PropertyGroup>
    <!-- Exclude both the Tests folder and the WinUI auto-generated win-x64 files
         from the main project compilation items to prevent workspace duplicates. -->
    <!-- Intercepts the WinUI compilation pipeline right before the workspace loader evaluates items -->
    <Target Name="RemoveWinUIDuplicatesFromFormat" BeforeTargets="CoreCompile;ComputeCompileInputs">
      <ItemGroup>
	<Compile Remove="Tests\**\*.cs" />
        <Compile Remove="obj\**\win-x64\**\*.cs" />
        <Compile Remove="$(BaseIntermediateOutputPath)**\*.cs" />
      </ItemGroup>
    </Target>
</Project>
