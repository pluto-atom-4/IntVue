<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="SimpleCapture.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls">

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="50" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="150" />
        </Grid.RowDefinitions>

        <!-- Left Control Panel -->
        <StackPanel Grid.Column="0" Grid.Row="0" Grid.RowSpan="3" Padding="10" Spacing="10">
            <TextBlock Text="Camera Settings" FontSize="16" FontWeight="Bold" />

            <TextBlock Text="Camera Device:" />
            <ComboBox x:Name="cbDeviceList" />

            <TextBlock Text="Preview Source:" />
            <ComboBox x:Name="cbPreviewSourceList" />

            <TextBlock Text="Video Profile:" />
            <ComboBox x:Name="cbProfileList" />

            <TextBlock Text="Capture Mode:" />
            <ComboBox x:Name="cbCaptureMode" />

            <TextBlock Text="Memory Preference:" />
            <ComboBox x:Name="cbMemoryPreferenceList" />

            <StackPanel Spacing="5">
                <Button x:Name="btnStartDevice" Content="Initialize Device" Click="BtnStartDevice_Click" />
                <Button x:Name="btnPreview" Content="Start Preview" Click="BtnPreview_Click" IsEnabled="False" />
		<Button x:Name="btnReset" Content="Reset Device" Click="BtnReset_Click" IsEnabled="False" />
		<Button x:Name="btnRecord" Content="Start Recording" Click="BtnRecord_Click" IsEnabled="False" Background="#4A1515" Foreground="White"/>
            </StackPanel>

            <TextBlock Text="Current Settings:" FontWeight="Bold" />
            <TextBlock x:Name="txtSettings" Text="" TextWrapping="Wrap" FontSize="12" />
        </StackPanel>

        <!-- Preview Area -->
        <controls:MediaPlayerElement
            x:Name="myPreview"
            Grid.Column="1"
            Grid.Row="0"
            Stretch="Uniform"
            Background="#1F1F1F" />

        <!-- Status Area -->
        <TextBlock
            x:Name="txtStatus"
            Grid.Column="1"
            Grid.Row="1"
            Text="Ready"
            Padding="10"
            Foreground="{ThemeResource SystemControlForegroundBaseHighBrush}" />

        <!-- Log Area -->
        <Border
            Grid.Column="1"
            Grid.Row="2"
            Background="#000000"
            BorderBrush="#333333"
            BorderThickness="1">
            <ScrollViewer>
                <TextBlock
                    x:Name="txtLog"
                    Text=""
                    TextWrapping="Wrap"
                    FontFamily="Courier New"
                    FontSize="10"
                    Foreground="#00FF00"
                    Padding="5" />
            </ScrollViewer>
        </Border>
    </Grid>
</Window>
