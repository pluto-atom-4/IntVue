<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="IntVue.Views.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://microsoft.com"
    xmlns:local="using:IntVue"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Preview host -->
        <controls:MediaPlayerElement x:Name="PreviewControl" AreTransportControlsEnabled="True" Grid.Row="0" />

        <!-- Controls -->
        <StackPanel Orientation="Horizontal" Grid.Row="1" HorizontalAlignment="Center" Margin="10">
            <Button x:Name="BtnPreview" Content="Start Preview" Click="BtnPreview_Click" IsEnabled="False" TabIndex="2" AccessKey="V" AutomationProperties.Name="PreviewButton" AutomationProperties.AutomationId="PreviewButtonAutomationId" />
            <Button x:Name="BtnRecord" Content="Start Recording" Click="BtnRecord_Click" IsEnabled="False" Margin="10,0,0,0" TabIndex="3" AccessKey="R" AutomationProperties.Name="RecordButton" AutomationProperties.AutomationId="RecordButtonAutomationId" />
            <Button x:Name="BtnPlay" Content="Play Recording" Click="BtnPlay_Click" IsEnabled="False" Margin="10,0,0,0" TabIndex="4" AccessKey="P" AutomationProperties.Name="PlayButton" AutomationProperties.AutomationId="PlayButtonAutomationId" />
            <Button x:Name="BtnDelete" Content="Delete Recording" Click="BtnDelete_Click" IsEnabled="False" Margin="10,0,0,0" TabIndex="5" AccessKey="D" AutomationProperties.Name="DeleteButton" AutomationProperties.AutomationId="DeleteRecordingButtonAutomationId" />
        </StackPanel>

        <!-- Device initialization -->
        <StackPanel Orientation="Horizontal" Grid.Row="2" Spacing="8" Margin="10">
            <ComboBox
                x:Name="CbCameraList"
                MinWidth="200"
                TabIndex="0"
                AutomationProperties.Name="Camera Device"
                AutomationProperties.AutomationId="CameraListAutomationId" />
            <Button
                Content="Initialize Device"
                Click="BtnInitializeDevice_Click"
                TabIndex="1"
                AccessKey="I"
                AutomationProperties.Name="InitializeDeviceButton"
                AutomationProperties.AutomationId="InitializeDeviceButtonAutomationId" />
        </StackPanel>
    </Grid>
</Page>
