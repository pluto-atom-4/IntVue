<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="IntVue.Views.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://microsoft.com"
    xmlns:local="using:IntVue"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls"
    mc:Ignorable="d"
    x:DataType="local:ViewModels.InterviewViewModel"> <!-- 👈 1. Added explicit compilation data type -->

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Preview host -->
        <controls:MediaPlayerElement x:Name="PreviewControl" AreTransportControlsEnabled="False" Grid.Row="0" />

        <!-- Controls -->
        <StackPanel Orientation="Horizontal" Grid.Row="1" HorizontalAlignment="Center" Margin="10">
            <Button x:Name="BtnPreview" Content="Start Preview" Click="BtnPreview_Click" IsEnabled="{x:Bind ViewModel.IsDeviceInitialized, Mode=OneWay}" AutomationProperties.Name="PreviewButton" />
            <Button x:Name="BtnRecord" Content="{x:Bind ViewModel.RecordButtonLabel, Mode=OneWay}" Click="BtnRecord_Click" IsEnabled="{x:Bind ViewModel.IsDeviceInitialized, Mode=OneWay}" Margin="10,0,0,0" AutomationProperties.Name="RecordButton" />
        </StackPanel>

        <!-- Device initialization -->
        <StackPanel Orientation="Horizontal" Grid.Row="2" Spacing="8" Margin="10">
            <ComboBox
                x:Name="CbCameraList"
                MinWidth="200"
                ItemsSource="{x:Bind ViewModel.Cameras, Mode=OneWay}"
                SelectedItem="{x:Bind ViewModel.SelectedCamera, Mode=TwoWay}"
                DisplayMemberPath="Name"
                AutomationProperties.Name="Camera Device" />
            <Button
                Content="Initialize Device"
                Click="BtnInitializeDevice_Click"
                AutomationProperties.Name="InitializeDeviceButton" />
        </StackPanel>
    </Grid>
</Page>
